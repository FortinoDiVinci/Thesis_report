<launch>

  <arg name="enable_sine_paddle" default="false" />
  <arg name="sim_rate" default="200" />
  <arg name="log_file_path" default="$(find ball_simulator)/log/log.txt" />
  <arg name="session_count" default="3" />
  <arg name="session_duration" default="10" />
  <arg name="target_height" default="2" />


  <param name="use_sim_time" value="true"/>

  <node name="clock" pkg="ball_simulator" type="clock" output="screen"/>

  <node name="ball_simulator" pkg="ball_simulator" type="ball_simulator_node" output="screen" required="true">
    <param name="enable_sine_paddle" value="$(arg enable_sine_paddle)"/>
    <param name="rate" value="$(arg sim_rate)"/>
  </node>
  
  <node name="logger" pkg="ball_simulator" type="logger" output="screen" />

  <node name="session_manager" pkg="ball_simulator" type="session_manager" output="screen">
    <param name="session_count" value="$(arg session_count)"/>
    <param name="session_duration" value="$(arg session_duration)"/>
    <param name="target_height" value="$(arg target_height)"/>
    <param name="log_file_base_name" value ="$(arg log_file_path)"/>
  </node>

  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find ball_simulator)/rviz/default.rviz"/>

  <node name="rqt_reconfigure" pkg="rqt_reconfigure" type="rqt_reconfigure" args="ball_simulator clock"/>

  
</launch>
