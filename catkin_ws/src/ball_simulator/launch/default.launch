<launch>
  
  <arg name="path" default="$(find ball_simulator)/logs" />
  <arg name="sine" default="false" />
  <arg name="rate" default="250" />
  
  <param name="use_sim_time" value="true"/>

  <node name="clock" pkg="ball_simulator" type="clock" output="screen"/>

  <node name="ball_simulator" pkg="ball_simulator" type="ball_simulator_node" output="screen">
    <param name="enable_sine_paddle" value="$(arg sine)"/>
    <param name="arm_frame_id" value="arm" />
    <param name="rate" value="500" />
  </node>

  <node name="logger" pkg="ball_simulator" type="logger" output="screen"/>

  <node name="session_manager" pkg="ball_simulator" type="session_manager" output="screen">
    <param name="log_file_path" value="$(arg path)" />
    <rosparam file="$(find ball_simulator)/config/example.yaml"/>
  </node>

  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find ball_simulator)/rviz/default.rviz"/>

  <node name="rqt_reconfigure" pkg="rqt_reconfigure" type="rqt_reconfigure" args="ball_simulator clock"/>

</launch>
