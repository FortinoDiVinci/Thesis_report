def broadcastThread(freq):
    th = threading.currentThread()
    br = tf.TransformBroadcaster()
    global z  # TODO a cleaner way should be used
        
    while getattr(th, "stop", False) == False:
        br.sendTransform((0, 0, z), tf.transformations.quaternion_from_euler(0, 0, 0), rospy.Time.now(), frame_id, parent_frame_id)
        time.sleep(1./freq)
            
    print("Exiting broadcasting thread...")
        

if __name__=="__main__":
    settings = termios.tcgetattr(sys.stdin)
    
    rospy.init_node('paddle_teleop')
    
    z = 1
    f = 500

    frame_id = 'arm'
    parent_frame_id = 'world'

    #th = BroadcastThread(f, args=z)
    #th.start()
    
    rospy.Rate(f)
    
    th = threading.Thread(target=broadcastThread, args=(f,))
    th.start()
    
    status = 0
    count = 0
    try:
        print(msg)
        while(1):
            key = getKey()
            if key in moveBindings.keys():
                z = z + moveBindings[key]
                speed = CST_SPEED
                count = 0
                #print('Current height %s' % z)
            elif key == ' ' or key == 'k' :
                speed = 0
            else:
                count = count + 1
                if count > 4:
                    speed = 0
                if (key == '\x03'):
                    break

    except Exception as e:
        print(e)

    finally:
        z = 0
        #real_paddle_pose.pose.position.z = 0       
        #th.stop()
        #th.join() 
        th.stop = True
        th.join()
    
    termios.tcsetattr(sys.stdin, termios.TCSADRAIN, settings)
