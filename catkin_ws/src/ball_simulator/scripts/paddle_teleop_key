import rospy

import geometry_msgs.msg
import tf # for the paddle height msg

import sys, select, termios, tty

import threading
import time


CST_SPEED = 0.02

msg = """
Control the paddle
---------------------------
u/j : move up/down

CTRL-C to quit
"""

moveBindings = {
        'j':-0.02,
        'u':0.02,
           }

def getKey():
    # to get only 1 char
    tty.setraw(sys.stdin.fileno())
    # check if there is any data in sys.stdin
    rlist, _, _ = select.select([sys.stdin], [], [], 0.1)
    if rlist:
        key = sys.stdin.read(1)
    else:
        key = ''

    termios.tcsetattr(sys.stdin, termios.TCSADRAIN, settings)

    return key

speed = 0


#class BroadcastThread(threading.Thread):

