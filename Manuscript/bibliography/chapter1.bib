@article{lazaric_origines_1992,
	title = {Origines et développement de la robotique},
	volume = {61},
	copyright = {free},
	url = {https://www.persee.fr/doc/rei_0154-3229_1992_num_61_1_1436},
	doi = {10.3406/rei.1992.1436},
	abstract = {Le développement de la robotique s'est réalisé avec des créations bien antérieures à l'Unimate et est fortement marqué par l'introduction des technologies électroniques modifiant profondément l'artefact. L'adoption croissante de ces nouvelles solutions techniques dans le sous-ensemble de motorisation, le système de commande et des périphériques n'a pas été linéaire car les innovations se sont combinées avec les anciens principes techniques entraînant une substitution très partielle. Les acteurs de plus n'ont pas eu des choix convergents tant pour les applications classiques (le soudage) que pour les projets novateurs (réseaux locaux industriels). Leur stratégie disparate et leur remise en cause de la sophistication technologique a freiné le développement intensif de l'électronnisation.},
