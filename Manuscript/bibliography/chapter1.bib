	number = {6862},
	urldate = {2018-10-17},
	journal = {Nature},
	author = {Burdet, Etienne and Osu, Rieko and Franklin, David W. and Milner, Theodore E. and Kawato, Mitsuo},
	month = nov,
	year = {2001},
	pages = {446--449}
}


