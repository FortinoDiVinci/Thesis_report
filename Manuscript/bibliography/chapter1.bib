	abstract = {In this contribution we present a robot assistant consisting of a mobile platform and a manipulator to support manual workplaces in production environments. We propose a general definition of robot assistants. Two applications for the robot assistant rob@work are described - the assembly of hydraulic pumps and the assistance of manual gas metal arc welding (GMAW). A description of the hardware and software architecture, the man-machine-interface, the task-planner and the path-planning of the robot assistant is given.},
	booktitle = {11th {IEEE} {International} {Workshop} on {Robot} and {Human} {Interactive} {Communication} {Proceedings}},
	author = {Helms, E. and Schraft, R.D. and Hagele, M.},
	month = sep,
	year = {2002},
	keywords = {Application software, Employment, Hardware, Manipulators, Mobile robots, Production, Robotic assembly, Service robots, Software architecture, Welding},
	pages = {399--404},
}

