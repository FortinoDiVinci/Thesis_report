	note = {ISSN: 2153-0858},
	keywords = {Impedance, manipulator dynamics, Robots, Torque, Acceleration, Joints, position control, redundant manipulators, Aerospace electronics, dynamic level control algorithm, Jacobian matrices, multipriority control, null-space impedance control, redundant robotic system},
	pages = {3752--3757},
}

