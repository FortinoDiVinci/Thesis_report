    \keyw{Humans, Movement, Muscle, Skeletal, Reflex, Stretch, Adult, Electric
  Impedance, Female, Male, Young Adult, Electromyography, Posture, Reflex,
  Torque, Knee, Knee impedance, Stiffness}
    \strng{namehash}{LD+1}
    \strng{fullhash}{LDPMPPPEJ1}
    \field{labelnamesource}{author}
