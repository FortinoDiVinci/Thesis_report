    \verb 10.1007/BF00338819
    \endverb
    \field{issn}{1432-0770}
    \field{number}{4}
    \field{pages}{257\bibrangedash 274}
    \field{title}{The control of hand equilibrium trajectories in multi-joint
  arm movements}
