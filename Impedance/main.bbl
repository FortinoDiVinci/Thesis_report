    \verb 10.1007/s00221-017-5032-2
    \endverb
    \field{issn}{1432-1106}
    \field{number}{10}
    \field{pages}{2959\bibrangedash 2970}
    \field{title}{Mechanisms contributing to reduced knee stiffness during
  movement}
