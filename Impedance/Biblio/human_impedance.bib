	keywords = {Elbow, Humans, Muscles, Impedance measurement, biomechanics, Damping, biocontrol, Central nervous system, Centralized control, dynamic impedance, elbow joints, equilibrium positions, human arm posture, joint damping, joint impedances, joint inertia, joint stiffness, loaded impedance, Motor drives, muscle, muscles, physiological models, resultant displacements, Shape, Shoulder, shoulder joints, stiffness-damping-mass characteristics},
	pages = {698--709}
}

