	keywords = {motion control, optimal control, Joints, Trajectory, Cost function, dynamical systems, efficient actuation, Modulation, Optimal control, optimisation, periodic movements, Resonant frequency, rhythmic movements, single pendulum, temporal optimization, timevarying stiffness profiles, underactuated two-link robot simulation},
