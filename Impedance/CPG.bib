	doi = {10.1109/RAMECH.2006.252614},
	abstract = {This paper presents some theoretical analysis for the neural oscillator, which is widely applied in the robot and biped control. The methods adopted here include stability theory, describing function, and linear piecewise analysis. Some prime properties of the neural oscillator such as the frequency determining, boundness, and stability are exploited. The insightful results will strengthen the foundation of the neural oscillator and enhance its efficient application for the bio-inspired robot control},
